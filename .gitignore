# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.egg-info/
dist/
build/

# Generated sourcebook packs
*.gmnpack

# Editor/IDE
# .idea/
.vscode/
.codex/
AGENTS.md
agents.md

# Mempalace
.mempalace/
entities.json
mempalace.yaml

# Node modules
node_modules/

# Android local SDK and IDE metadata
android/local.properties
android/.idea/
android/.gradle/
android/.kotlin/
*.iml

# Android generated build outputs
android/build/
android/**/build/
android/captures/
android/.externalNativeBuild/
android/**/.externalNativeBuild/
android/.cxx/
android/**/.cxx/

# Android packaged artifacts
*.apk
*.aab
*.ap_
*.dex

# Android signing and local service files
*.jks
*.keystore
android/**/google-services.json

# GitHub local steering files
.github/*
!.github/workflows/
!.github/workflows/**
.github/instructions/
