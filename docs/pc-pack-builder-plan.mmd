flowchart LR
  subgraph Input[User Local Files]
    PDF[Owned PDF sourcebook]
    Flags[CLI flags\nsystem + edition + title]
    Config[Optional JSON config\nrepeatable builds]
  end

  subgraph Builder[PC Pack Builder CLI]
    Extract[PDF extraction\npage-aware text]
    Cleanup[Text cleanup\nheaders + hyphen repair]
    Chunk[Chunking\nparagraph-aware citations]
    Quality[Chunk quality\noverlap + dedupe]
    Embed[Embedding generation\none vector per chunk]
    Diagnostics[Advanced diagnostics\nOCR + tables + columns]
    Validate[Pack validation\ncounts + schema + checksums]
    Write[Pack writer\nZIP archive]
    Compare[Compare extractors\nPyMuPDF vs pdfplumber]
    Schema[Schema command\npack contract]
    Inspect[Inspection commands\nreport + sample chunks]
  end

  subgraph Pack[GMN Pack Output]
    Manifest[manifest.json]
    Docs[documents.json]
    Chunks[chunks.jsonl]
    Vectors[embeddings.npy]
    Report[extraction-report.json]
  end

  PDF --> Extract
  Flags --> Extract
  Config --> Extract
  Extract --> Cleanup --> Chunk --> Quality --> Embed --> Diagnostics --> Validate --> Write
  Extract --> Compare
  Write --> Manifest
  Write --> Docs
  Write --> Chunks
  Write --> Vectors
  Write --> Report
  Pack --> Inspect
  Schema --> Import
  Pack --> Import[Android pack importer]

  classDef input fill:#f7f7f7,stroke:#666,color:#111;
  classDef process fill:#e8f3ff,stroke:#2f6f9f,color:#10233f;
  classDef output fill:#e9f7ef,stroke:#2d7d46,color:#13331f;

  class PDF,Flags,Config input;
  class Extract,Cleanup,Chunk,Quality,Embed,Diagnostics,Validate,Write,Compare,Schema,Inspect process;
  class Manifest,Docs,Chunks,Vectors,Report,Import output;
